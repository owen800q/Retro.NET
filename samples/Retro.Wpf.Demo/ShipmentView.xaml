<UserControl x:Class="Retro.Wpf.Demo.ShipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:retro="https://github.com/owen800q/Retro.NET"
             FontFamily="{DynamicResource Retro.FontFamily}" FontSize="{DynamicResource Retro.FontSize.SM}"
             Foreground="{DynamicResource Retro.Foreground}" Background="{DynamicResource Retro.Surface}"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <DockPanel>

    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Shipment">
        <MenuItem Header="_New" InputGestureText="Ctrl+N" retro:Assist.Icon="New" Click="OnNew"/>
        <MenuItem Header="_Open…" InputGestureText="Ctrl+O" retro:Assist.Icon="Open" Click="OnOpen"/>
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" retro:Assist.Icon="Save" Click="OnSave"/>
        <MenuItem Header="Save _As…" retro:Assist.Icon="SaveAs" IsEnabled="False"/>
        <Separator/>
        <MenuItem Header="_Print…" InputGestureText="Ctrl+P" retro:Assist.Icon="Print" Click="OnPrint"/>
        <Separator/>
        <MenuItem Header="E_xit" InputGestureText="Alt+F4" retro:Assist.Icon="Close" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" retro:Assist.Icon="Cut"/>
        <MenuItem Header="_Copy" InputGestureText="Ctrl+C" retro:Assist.Icon="Copy"/>
        <MenuItem Header="_Paste" InputGestureText="Ctrl+V" retro:Assist.Icon="Paste"/>
        <Separator/>
        <MenuItem Header="_Delete" InputGestureText="Shift+F2" retro:Assist.Icon="Delete" Click="OnDelete"/>
      </MenuItem>
      <MenuItem Header="_Goto">
        <MenuItem Header="Component _Gallery…" retro:Assist.Icon="Table" Click="OnGallery"/>
        <MenuItem Header="_Back" retro:Assist.Icon="Back" Click="OnBack"/>
        <MenuItem Header="_Settings">
          <MenuItem Header="Express Delivery" IsCheckable="True" IsChecked="{Binding Express}"/>
          <MenuItem Header="Table Settings…" retro:Assist.Icon="Settings"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="S_ystem"/>
      <MenuItem Header="_Help">
        <MenuItem Header="_Application Help" InputGestureText="F1" retro:Assist.Icon="Help" Click="OnHelp"/>
      </MenuItem>
    </Menu>

    <!-- Application toolbar -->
    <ToolBar DockPanel.Dock="Top">
      <Button retro:Assist.Icon="New" ToolTip="New" Click="OnNew"/>
      <Button retro:Assist.Icon="Open" ToolTip="Open" Click="OnOpen"/>
      <Button retro:Assist.Icon="Save" ToolTip="Save (Ctrl+S)" Click="OnSave"/>
      <Separator/>
      <Button retro:Assist.Icon="Print" ToolTip="Print" Click="OnPrint"/>
      <Button retro:Assist.Icon="Find" ToolTip="Find" Click="OnFind"/>
      <Separator/>
      <Button retro:Assist.Icon="Back" ToolTip="Back (F3)"/>
      <Button retro:Assist.Icon="Forward" ToolTip="Forward"/>
      <Button retro:Assist.Icon="Up" ToolTip="Up"/>
      <Separator/>
      <Button retro:Assist.Icon="Execute" Content="Execute" ToolTip="Execute (F8)" Padding="5,2" Click="OnExecute"/>
      <Button retro:Assist.Icon="Refresh" ToolTip="Refresh" Click="OnRefresh"/>
      <Button retro:Assist.Icon="Delete" ToolTip="Delete (Shift+F2)" Click="OnDelete"/>
      <Separator/>
      <Button retro:Assist.Icon="Table" ToolTip="Table Settings" Click="OnTable"/>
      <Button retro:Assist.Icon="Filter" ToolTip="Filter" Click="OnFilter"/>
      <Button retro:Assist.Icon="Sort" ToolTip="Sort" Click="OnSort"/>
      <Button retro:Assist.Icon="Export" ToolTip="Export" Click="OnExport"/>
      <Separator/>
      <Button retro:Assist.Icon="Help" ToolTip="Help" Click="OnHelp"/>
    </ToolBar>

    <!-- Status bar -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem DockPanel.Dock="Right" Margin="0">
        <TextBlock Style="{StaticResource Retro.Text.Mono}" FontSize="{DynamicResource Retro.FontSize.XS}"
                   Text="VL01N · MUC-PRD-01 · 14:55:1293"/>
      </StatusBarItem>
      <StatusBarItem>
        <TextBlock x:Name="StatusText" FontWeight="Bold" Text="{Binding StatusMessage}"/>
      </StatusBarItem>
    </StatusBar>

    <!-- Transaction content -->
    <DockPanel Margin="6">
      <retro:Bevel DockPanel.Dock="Top" Style="{StaticResource Retro.Banner}" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal">
          <retro:RetroIcon Kind="Info" Size="14" Margin="0,0,6,0"/>
          <TextBlock VerticalAlignment="Center">
            You are viewing this document in <Bold>Display</Bold> mode. Switch to
            <Hyperlink Click="OnChangeMode">Change</Hyperlink> to edit.
          </TextBlock>
        </StackPanel>
      </retro:Bevel>

      <retro:Bevel DockPanel.Dock="Top" Style="{StaticResource Retro.InsetPanel}" Margin="0,0,0,6">
        <retro:Breadcrumb ItemClick="OnCrumb">
          <retro:BreadcrumbItem Content="Home"/>
          <retro:BreadcrumbItem Content="Logistics"/>
          <retro:BreadcrumbItem Content="Shipment"/>
          <retro:BreadcrumbItem>
            <TextBlock FontWeight="Bold" Text="{Binding ShipmentId}"/>
          </retro:BreadcrumbItem>
        </retro:Breadcrumb>
      </retro:Bevel>

      <!-- Footer row: selection summary + Save / Back / Cancel -->
      <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button retro:Assist.Icon="Save" Content="Save" Click="OnSave"/>
          <Button retro:Assist.Icon="Back" Content="Back" Margin="4,0,0,0" Click="OnBack"/>
          <Button Content="Cancel" Margin="4,0,0,0" Click="OnCancel"/>
        </StackPanel>
        <TextBlock x:Name="Summary" Style="{StaticResource Retro.Text.Help}" VerticalAlignment="Center"
                   Text="{Binding SelectionSummary}" Visibility="Hidden"/>
      </DockPanel>

      <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
        <!-- Header -->
        <TabItem Header="Header">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="General data">
              <StackPanel>
                <retro:FormField Label="Shipment" IsRequired="True" LabelWidth="100">
                  <StackPanel Orientation="Horizontal">
                    <TextBox Width="140" Text="{Binding ShipmentId, Mode=OneWay}" IsEnabled="False"/>
                    <TextBlock Style="{StaticResource Retro.Text.Help}" Margin="6,0,0,0" VerticalAlignment="Center"
                               Text="VL01N · 0000080014"/>
                  </StackPanel>
                </retro:FormField>
                <retro:FormField Label="Carrier" IsRequired="True" LabelWidth="100">
                  <ComboBox Width="200" ItemsSource="{Binding Carriers}" SelectedItem="{Binding Carrier}"/>
                </retro:FormField>
                <retro:FormField Label="Service" LabelWidth="100">
                  <ComboBox Width="200" ItemsSource="{Binding Services}" SelectedItem="{Binding Service}"/>
                </retro:FormField>
                <retro:FormField Label="Route" LabelWidth="100">
                  <TextBox Width="200" Text="{Binding Route, UpdateSourceTrigger=PropertyChanged}"/>
                </retro:FormField>
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Dates &amp; Status">
              <StackPanel>
                <retro:FormField Label="Pickup" LabelWidth="100">
                  <TextBox Width="120" Text="{Binding Pickup}"/>
                </retro:FormField>
                <retro:FormField Label="Delivery" LabelWidth="100">
                  <TextBox Width="120" Text="{Binding Delivery}"/>
                </retro:FormField>
                <retro:FormField Label="Priority" LabelWidth="100">
                  <ComboBox Width="120" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}"/>
                </retro:FormField>
                <retro:FormField Label="Express?" LabelWidth="100">
                  <StackPanel Orientation="Horizontal">
                    <retro:ToggleSwitch IsChecked="{Binding Express}"/>
                    <TextBlock Style="{StaticResource Retro.Text.Help}" Margin="6,0,0,0" VerticalAlignment="Center"
                               Text="{Binding ExpressNote}"/>
                  </StackPanel>
                </retro:FormField>
                <retro:FormField Label="Status" LabelWidth="100">
                  <retro:Tag Tone="Warning" Content="Pending posting"/>
                </retro:FormField>
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="Customer">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <retro:FormField Label="Customer No." LabelWidth="100">
                    <TextBox Width="120" Text="6000068250"/>
                  </retro:FormField>
                  <retro:FormField Label="Tax ID" LabelWidth="100">
                    <TextBox Width="120" Text="DE123456789"/>
                  </retro:FormField>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                  <retro:FormField Label="Name" LabelWidth="100">
                    <TextBox Width="260" Text="ACME Industrial Logistics GmbH"/>
                  </retro:FormField>
                  <retro:FormField Label="Payment" LabelWidth="100">
                    <ComboBox Width="140" ItemsSource="{Binding PaymentTerms}" SelectedItem="{Binding Payment}"/>
                  </retro:FormField>
                </StackPanel>
              </Grid>
            </GroupBox>
          </Grid>
        </TabItem>

        <!-- Items -->
        <TabItem Header="{Binding ItemsHeader}">
          <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                    SelectionMode="Extended" IsReadOnly="True">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Width="22"
                                      ElementStyle="{StaticResource Retro.DataGridCheckBox}"/>
              <DataGridTextColumn Header="Document" Binding="{Binding Doc}" Width="110"/>
              <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/>
              <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="60">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="UoM" Binding="{Binding Uom}" Width="50"/>
              <DataGridTextColumn Header="Unit Price" Binding="{Binding Price, StringFormat=N2, ConverterCulture=en-US}" Width="100">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2, ConverterCulture=en-US}" Width="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="Status" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <retro:Tag Tone="{Binding StatusTone}" Content="{Binding Status}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

        <!-- Documents -->
        <TabItem Header="Documents">
          <retro:EmptyState Icon="Document" Title="No Documents"
                            Description="Attach a delivery note, invoice, or photo to this shipment.">
            <retro:EmptyState.Action>
              <Button retro:Assist.Icon="Attach" Content="Attach…" Click="OnAttach"/>
            </retro:EmptyState.Action>
          </retro:EmptyState>
        </TabItem>

        <TabItem Header="Log" IsEnabled="False"/>
      </TabControl>
    </DockPanel>
  </DockPanel>
</UserControl>
