<!-- TextBox, PasswordBox, ComboBox. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:retro="clr-namespace:Retro.Wpf"
                    xmlns:ctl="clr-namespace:Retro.Wpf.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Shared.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Inputs show errors through their fill; suppress WPF's red adorner. -->
  <ControlTemplate x:Key="Retro.NoErrorTemplate">
    <AdornedElementPlaceholder/>
  </ControlTemplate>

  <Style x:Key="Retro.InputBase" TargetType="Control">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.SurfaceInset}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <!-- CSS: padding 2px 4px, 20px tall plus the 1px black outline. -->
    <Setter Property="Padding" Value="1,0"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Retro.NoErrorTemplate}"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
  </Style>

  <!-- ===== TextBox ====================================================== -->
  <Style TargetType="TextBox" BasedOn="{StaticResource Retro.InputBase}">
    <Setter Property="SelectionBrush" Value="{DynamicResource Retro.HeaderBlue2}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="AllowDrop" Value="True"/>
    <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
    <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ctl:Bevel x:Name="Bevel" Kind="SunkenStrong" Background="{TemplateBinding Background}"
                     LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}"
                     OutlineBrush="{DynamicResource Retro.BorderBlack}">
            <Grid Margin="{TemplateBinding Padding}">
              <TextBlock x:Name="Placeholder" Text="{TemplateBinding retro:Assist.Placeholder}" Margin="3,0,0,0"
                         FontStyle="Italic" Foreground="{DynamicResource Retro.ForegroundMuted}" Visibility="Collapsed"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False"/>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsKeyboardFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Surface3}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputFocusBackground}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputErrorBackground}"/>
            </Trigger>
            <Trigger Property="retro:Assist.IsError" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputErrorBackground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="AcceptsReturn" Value="True">
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="1,1"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== PasswordBox ================================================== -->
  <Style TargetType="PasswordBox" BasedOn="{StaticResource Retro.InputBase}">
    <Setter Property="SelectionBrush" Value="{DynamicResource Retro.HeaderBlue2}"/>
    <Setter Property="PasswordChar" Value="*"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <ctl:Bevel x:Name="Bevel" Kind="SunkenStrong" Background="{TemplateBinding Background}"
                     LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}"
                     OutlineBrush="{DynamicResource Retro.BorderBlack}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputFocusBackground}"/>
            </Trigger>
            <Trigger Property="retro:Assist.IsError" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputErrorBackground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ComboBox ===================================================== -->
  <!-- The raised 16px arrow box at the right edge of select fields. -->
  <Style x:Key="Retro.ComboBoxToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <ctl:Bevel x:Name="Arrow" Kind="Raised" Width="16" HorizontalAlignment="Right" Margin="0,1,1,1"
                       Background="{DynamicResource Retro.Gradient.Button}"
                       LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}">
              <Path x:Name="Glyph" Data="{StaticResource Retro.Glyph.ArrowDown}" Fill="{DynamicResource Retro.Foreground}"
                    Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
            </ctl:Bevel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Arrow" Property="Kind" Value="Sunken"/>
              <Setter TargetName="Arrow" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Retro.ForegroundDisabled}"/>
              <Setter TargetName="Arrow" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Retro.ComboBoxEditableTextBox" TargetType="TextBox">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="AllowDrop" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Retro.HeaderBlue2}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Retro.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Retro.HeaderBlue2}"/>
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundOnHeader}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource Retro.InputBase}">
    <Setter Property="Padding" Value="1,0,18,0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
    <Setter Property="MaxDropDownHeight" Value="240"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="Root">
            <ctl:Bevel x:Name="Bevel" Kind="SunkenStrong" Background="{TemplateBinding Background}"
                       LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}"
                       OutlineBrush="{DynamicResource Retro.BorderBlack}">
              <Grid Margin="{TemplateBinding Padding}">
                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="3,0,0,0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource Retro.ComboBoxEditableTextBox}"
                         Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                <TextBlock x:Name="Placeholder" Text="{TemplateBinding retro:Assist.Placeholder}" Margin="3,0,0,0"
                           FontStyle="Italic" Foreground="{DynamicResource Retro.ForegroundMuted}" Visibility="Collapsed"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </ctl:Bevel>
            <ToggleButton x:Name="Toggle" Style="{StaticResource Retro.ComboBoxToggle}" Margin="1"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
              <Border x:Name="DropDown" Background="{DynamicResource Retro.SurfaceInset}" BorderThickness="1"
                      BorderBrush="{DynamicResource Retro.BorderBlack}" SnapsToDevicePixels="True"
                      MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="Toggle" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Toggle" Property="Width" Value="18"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="SelectedItem" Value="{x:Null}"/>
                <Condition Property="IsEditable" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputFocusBackground}"/>
            </Trigger>
            <Trigger Property="retro:Assist.IsError" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputErrorBackground}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputErrorBackground}"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="DropDown" Property="MinHeight" Value="20"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
            <Trigger Property="IsGrouping" Value="True">
              <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
