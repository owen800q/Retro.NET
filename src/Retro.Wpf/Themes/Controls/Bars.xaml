<!-- ToolBar, ToolBarTray, StatusBar. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Retro.Wpf.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Shared.xaml"/>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Controls/Buttons.xaml"/>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Controls/Inputs.xaml"/>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Controls/Selection.xaml"/>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Controls/Menus.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Styles the ToolBar applies to its children (otherwise it falls back to the OS theme). -->
  <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource Retro.ToolbarButton}"/>
  <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton" BasedOn="{StaticResource Retro.ToolbarButton}"/>
  <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource Retro.VerticalSeparator}"/>
  <Style x:Key="{x:Static ToolBar.CheckBoxStyleKey}" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="Margin" Value="2,0"/>
  </Style>
  <Style x:Key="{x:Static ToolBar.RadioButtonStyleKey}" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
    <Setter Property="Margin" Value="2,0"/>
  </Style>
  <Style x:Key="{x:Static ToolBar.TextBoxStyleKey}" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Margin" Value="2,0"/>
  </Style>
  <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Margin" Value="2,0"/>
  </Style>
  <Style x:Key="{x:Static ToolBar.MenuStyleKey}" TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style x:Key="Retro.ToolBarOverflowToggle" TargetType="ToggleButton" BasedOn="{StaticResource Retro.ToolbarButton}">
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Padding" Value="1"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Content">
      <Setter.Value>
        <Path Data="{StaticResource Retro.Glyph.ArrowDown}" Fill="{DynamicResource Retro.Foreground}" Stretch="None"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolBar">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Gradient.Toolbar}"/>
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="ToolBarTray.IsLocked" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolBar">
          <Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Retro.BorderMid}"
                  Padding="{TemplateBinding Padding}">
            <DockPanel>
              <Grid DockPanel.Dock="Right" x:Name="OverflowGrid">
                <ToggleButton x:Name="OverflowButton" Style="{StaticResource Retro.ToolBarOverflowToggle}" ClickMode="Press"
                              IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              IsEnabled="{TemplateBinding HasOverflowItems}"/>
                <Popup x:Name="OverflowPopup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                       StaysOpen="False" IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <ctl:Bevel Style="{StaticResource Retro.MenuPanel}" Background="{DynamicResource Retro.Surface3}" Padding="2" MinWidth="0">
                    <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="200" FocusVisualStyle="{x:Null}" Focusable="True"
                                          KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                  </ctl:Bevel>
                </Popup>
              </Grid>
              <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="HasOverflowItems" Value="False">
              <Setter TargetName="OverflowGrid" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolBarTray">
    <Setter Property="Background" Value="{DynamicResource Retro.Gradient.Toolbar}"/>
    <Setter Property="IsLocked" Value="True"/>
  </Style>

  <!-- ===== StatusBar ==================================================== -->
  <Style TargetType="StatusBarItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="StatusBarItem">
          <ContentPresenter Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static StatusBar.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource Retro.VerticalSeparator}">
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>

  <Style TargetType="StatusBar">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.XS}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <Setter Property="Padding" Value="5,1"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="StatusBar">
          <ctl:Bevel Kind="Sunken" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                     LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}">
            <ItemsPresenter/>
          </ctl:Bevel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
