<!-- TabControl / TabItem, GroupBox (fieldset), Expander (collapse). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Retro.Wpf.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Shared.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- ===== Tabs ========================================================= -->
  <Style TargetType="TabItem">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <!-- CSS: padding 4px 14px 5px; active tab grows 1px taller. -->
    <Setter Property="Padding" Value="14,4,14,5"/>
    <Setter Property="Margin" Value="0,0,1,-1"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Retro.FocusVisual.Tight}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <ctl:TabShape x:Name="Shape" Background="{TemplateBinding Background}"
                        LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}">
            <ContentPresenter x:Name="Header" ContentSource="Header" RecognizesAccessKey="True"
                              Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ctl:TabShape>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Retro.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Panel.ZIndex" Value="2"/>
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Retro.HeaderBlue2}"/>
              <Setter TargetName="Shape" Property="LightBrush" Value="{DynamicResource Retro.HeaderGloss}"/>
              <Setter TargetName="Shape" Property="DarkBrush" Value="{x:Null}"/>
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundOnHeader}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter TargetName="Header" Property="Margin" Value="14,4,14,6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tab strip with a dark baseline, 4px gap, then a raised panel holding the page. -->
  <Style TargetType="TabControl">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Retro.BorderDark}" Margin="0,0,0,4">
              <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1"/>
            </Border>
            <ctl:Bevel Grid.Row="1" Kind="RaisedStrong" Background="{TemplateBinding Background}"
                       LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}"
                       OutlineBrush="{DynamicResource Retro.BorderBlack}"
                       KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
            </ctl:Bevel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== GroupBox: beveled fieldset with a floating bold legend ======= -->
  <Style TargetType="GroupBox">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <!-- CSS: padding 14px 10px 10px, minus the 1px inner bevel line. -->
    <Setter Property="Padding" Value="9,13,9,9"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Grid>
            <ctl:Bevel x:Name="Frame" Kind="Fieldset" Margin="0,7,0,0" Background="{TemplateBinding Background}"
                       LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}">
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </ctl:Bevel>
            <Border x:Name="Legend" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,0,0,0" Padding="4,0"
                    Background="{DynamicResource Retro.Surface}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                TextElement.FontFamily="{DynamicResource Retro.FontFamily.Bold}" TextElement.FontWeight="Bold"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
              <Setter TargetName="Legend" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Frame" Property="Margin" Value="0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Expander (Collapse) ========================================== -->
  <Style x:Key="Retro.ExpanderHeader" TargetType="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <ctl:Bevel x:Name="Bevel" Kind="Raised" Background="{DynamicResource Retro.Gradient.Toolbar}"
                     LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}"
                     Padding="5,2">
            <DockPanel>
              <Path x:Name="Arrow" DockPanel.Dock="Right" Data="{StaticResource Retro.Glyph.ArrowDown}"
                    Fill="{DynamicResource Retro.Foreground}" Stretch="None" VerticalAlignment="Center" Margin="6,0,0,0"/>
              <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </DockPanel>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Arrow" Property="Data" Value="{StaticResource Retro.Glyph.ArrowUp}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Expander">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <ctl:Bevel Kind="RaisedStrong" Background="{TemplateBinding Background}"
                     LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}"
                     OutlineBrush="{DynamicResource Retro.BorderDark}">
            <DockPanel>
              <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Style="{StaticResource Retro.ExpanderHeader}"
                            Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                            FocusVisualStyle="{StaticResource Retro.FocusVisual.Tight}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter x:Name="ExpandSite" Margin="{TemplateBinding Padding}" Visibility="Collapsed"/>
            </DockPanel>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
