<!-- Button, ToggleButton, RepeatButton and the toolbar / page button variants. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:retro="clr-namespace:Retro.Wpf"
                    xmlns:ctl="clr-namespace:Retro.Wpf.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Shared.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Icon + content row shared by every button template. -->
  <ControlTemplate x:Key="Retro.ButtonTemplate" TargetType="ButtonBase">
    <ctl:Bevel x:Name="Bevel" Kind="RaisedStrong" Background="{TemplateBinding Background}"
               LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}"
               OutlineBrush="{DynamicResource Retro.BorderBlack}">
      <StackPanel x:Name="Row" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
        <ctl:RetroIcon x:Name="Icon" Margin="0,0,4,0" VerticalAlignment="Center"
                       Kind="{Binding (retro:Assist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Retro.NullSkip}}"/>
        <ContentPresenter x:Name="Content" RecognizesAccessKey="True" VerticalAlignment="Center"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
      </StackPanel>
    </ctl:Bevel>
    <ControlTemplate.Triggers>
      <Trigger Property="retro:Assist.Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="Icon" Property="Margin" Value="0"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonHover}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonPressed}"/>
        <Setter TargetName="Bevel" Property="Kind" Value="SunkenStrong"/>
        <Setter TargetName="Row" Property="RenderTransform">
          <Setter.Value>
            <TranslateTransform X="1" Y="1"/>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonPressed}"/>
        <Setter TargetName="Bevel" Property="Kind" Value="SunkenStrong"/>
        <Setter TargetName="Row" Property="RenderTransform">
          <Setter.Value>
            <TranslateTransform X="1" Y="1"/>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
        <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
        <Setter TargetName="Bevel" Property="Kind" Value="RaisedStrong"/>
        <Setter TargetName="Bevel" Property="OutlineBrush" Value="{x:Null}"/>
        <Setter TargetName="Icon" Property="Opacity" Value="0.45"/>
        <Setter TargetName="Content" Property="Effect">
          <Setter.Value>
            <DropShadowEffect Color="White" ShadowDepth="1.414" Direction="315" BlurRadius="0" Opacity="1"/>
          </Setter.Value>
        </Setter>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Retro.ButtonBase" TargetType="ButtonBase">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Gradient.Button}"/>
    <!-- CSS: padding 3px 12px inside a 1px bevel; min-height 22px plus the 1px black outline. -->
    <Setter Property="Padding" Value="11,2"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Retro.FocusVisual}"/>
    <Setter Property="Template" Value="{StaticResource Retro.ButtonTemplate}"/>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Retro.ButtonBase}"/>
  <Style TargetType="ToggleButton" BasedOn="{StaticResource Retro.ButtonBase}"/>
  <Style TargetType="RepeatButton" BasedOn="{StaticResource Retro.ButtonBase}"/>

  <!-- Icon-only button with square padding. -->
  <Style x:Key="Retro.IconButton" TargetType="ButtonBase" BasedOn="{StaticResource Retro.ButtonBase}">
    <Setter Property="Padding" Value="4,2"/>
  </Style>

  <!-- Flat toolbar button: transparent until hovered, then amber with a raised bevel. -->
  <ControlTemplate x:Key="Retro.ToolbarButtonTemplate" TargetType="ButtonBase">
    <ctl:Bevel x:Name="Bevel" Kind="Raised" Background="{TemplateBinding Background}" IsBorderVisible="False"
               LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}">
      <StackPanel x:Name="Row" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
        <ctl:RetroIcon x:Name="Icon" Margin="0,0,4,0" VerticalAlignment="Center"
                       Kind="{Binding (retro:Assist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Retro.NullSkip}}"/>
        <ContentPresenter x:Name="Content" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      </StackPanel>
    </ctl:Bevel>
    <ControlTemplate.Triggers>
      <Trigger Property="retro:Assist.Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="Icon" Property="Margin" Value="0"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.AccentSoft}"/>
        <Setter TargetName="Bevel" Property="IsBorderVisible" Value="True"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bevel" Property="Kind" Value="Sunken"/>
        <Setter TargetName="Bevel" Property="IsBorderVisible" Value="True"/>
      </Trigger>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter TargetName="Bevel" Property="Kind" Value="Sunken"/>
        <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.AccentSoft}"/>
        <Setter TargetName="Bevel" Property="IsBorderVisible" Value="True"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
        <Setter TargetName="Icon" Property="Opacity" Value="0.4"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Retro.ToolbarButton" TargetType="ButtonBase">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="3,2"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Retro.FocusVisual.Tight}"/>
    <Setter Property="Template" Value="{StaticResource Retro.ToolbarButtonTemplate}"/>
  </Style>

  <Style x:Key="Retro.ToolbarToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource Retro.ToolbarButton}"/>

  <!-- Re-export the link style so it is reachable from the full theme. -->
  <Style x:Key="Retro.Link" TargetType="ButtonBase" BasedOn="{StaticResource Retro.LinkButton}"/>

</ResourceDictionary>
