<!-- Calendar and DatePicker. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:retro="clr-namespace:Retro.Wpf"
                    xmlns:ctl="clr-namespace:Retro.Wpf.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Shared.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Day cell: amber + black ring when selected, pale amber on hover, gray outside the month. -->
  <Style x:Key="Retro.CalendarDayButton" TargetType="CalendarDayButton">
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.XS}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="MinWidth" Value="26"/>
    <Setter Property="MinHeight" Value="16"/>
    <Setter Property="Padding" Value="3,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarDayButton">
          <Border x:Name="Bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsToday" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Retro.HeaderBlue2}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Retro.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Retro.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Retro.Accent}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Retro.BorderBlack}"/>
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundOnAccent}"/>
              <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Month / year cell in the year and decade views. -->
  <Style x:Key="Retro.CalendarButton" TargetType="CalendarButton">
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.XS}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="MinWidth" Value="44"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarButton">
          <Border x:Name="Bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Retro.AccentSoft}"/>
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Retro.Accent}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Retro.BorderBlack}"/>
              <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ‹ / › / title buttons sitting on the blue title-bar gradient. -->
  <Style x:Key="Retro.CalendarHeaderButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundOnHeader}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily.Bold}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Padding" Value="4,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
              <ContentPresenter.Effect>
                <DropShadowEffect Color="Black" Opacity="0.4" ShadowDepth="1" Direction="270" BlurRadius="0"/>
              </ContentPresenter.Effect>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Retro.CalendarItem" TargetType="CalendarItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarItem">
          <ControlTemplate.Resources>
            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
              <Border Background="{DynamicResource Retro.Surface3}" Padding="3,1">
                <TextBlock Text="{Binding}" FontFamily="{DynamicResource Retro.FontFamily.Bold}" FontWeight="Bold"
                           FontSize="{DynamicResource Retro.FontSize.XS}" HorizontalAlignment="Center"/>
              </Border>
            </DataTemplate>
          </ControlTemplate.Resources>
          <Grid x:Name="PART_Root">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource Retro.Gradient.TitleBar}" Margin="0,0,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="PART_PreviousButton" Style="{StaticResource Retro.CalendarHeaderButton}">
                <Path Data="{StaticResource Retro.Glyph.ArrowLeft}" Fill="{DynamicResource Retro.ForegroundOnHeader}" Stretch="None"/>
              </Button>
              <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource Retro.CalendarHeaderButton}"/>
              <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource Retro.CalendarHeaderButton}">
                <Path Data="{StaticResource Retro.Glyph.ArrowRight}" Fill="{DynamicResource Retro.ForegroundOnHeader}" Stretch="None"/>
              </Button>
            </Grid>
            <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
            </Grid>
            <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
            </Grid>
            <Rectangle x:Name="PART_DisabledVisual" Grid.RowSpan="2" Fill="{DynamicResource Retro.Surface2}" Opacity="0.6"
                       Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/>
            </Trigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Calendar">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.XS}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <Setter Property="Padding" Value="7"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="CalendarItemStyle" Value="{StaticResource Retro.CalendarItem}"/>
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Retro.CalendarDayButton}"/>
    <Setter Property="CalendarButtonStyle" Value="{StaticResource Retro.CalendarButton}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Calendar">
          <ctl:Bevel Kind="Raised" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                     LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}">
            <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/>
          </ctl:Bevel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== DatePicker =================================================== -->
  <Style TargetType="DatePickerTextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Retro.HeaderBlue2}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="WatermarkStates">
                <VisualState x:Name="Unwatermarked"/>
                <VisualState x:Name="Watermarked">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentControl x:Name="PART_Watermark" Opacity="0" Focusable="False" IsHitTestVisible="False" Margin="3,0,0,0"
                            FontStyle="Italic" Foreground="{DynamicResource Retro.ForegroundMuted}" VerticalAlignment="Center"/>
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Retro.DatePickerButton" TargetType="Button">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ctl:Bevel x:Name="Bevel" Kind="Raised" Width="20" Background="{DynamicResource Retro.Gradient.Button}"
                     LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}">
            <ctl:RetroIcon Kind="Calendar" Size="14"/>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bevel" Property="Kind" Value="Sunken"/>
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonPressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.SurfaceInset}"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="IsTodayHighlighted" Value="True"/>
    <Setter Property="SelectedDateFormat" Value="Short"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <ctl:Bevel x:Name="Bevel" Kind="SunkenStrong" Background="{TemplateBinding Background}"
                     LightBrush="{DynamicResource Retro.BorderLight}" DarkBrush="{DynamicResource Retro.BorderDark}"
                     OutlineBrush="{DynamicResource Retro.BorderBlack}">
            <Grid x:Name="PART_Root">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <DatePickerTextBox x:Name="PART_TextBox" Margin="1,0" VerticalAlignment="Stretch"
                                 Foreground="{TemplateBinding Foreground}" Focusable="{TemplateBinding Focusable}"/>
              <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource Retro.DatePickerButton}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}"
                     AllowsTransparency="True" StaysOpen="False" PopupAnimation="None"/>
            </Grid>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputFocusBackground}"/>
            </Trigger>
            <Trigger Property="retro:Assist.IsError" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.InputErrorBackground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
