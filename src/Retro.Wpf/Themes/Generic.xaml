<!-- Default styles of the Retro.Wpf custom controls. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:retro="clr-namespace:Retro.Wpf"
                    xmlns:ctl="clr-namespace:Retro.Wpf.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Retro.Wpf;component/Themes/Shared.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- ===== Bevel: bind the line colors to the tokens ==================== -->
  <Style TargetType="ctl:Bevel">
    <Setter Property="LightBrush" Value="{DynamicResource Retro.BorderLight}"/>
    <Setter Property="DarkBrush" Value="{DynamicResource Retro.BorderDark}"/>
    <Setter Property="FlatBrush" Value="{DynamicResource Retro.BorderMid}"/>
    <Setter Property="OutlineBrush" Value="{DynamicResource Retro.BorderBlack}"/>
  </Style>

  <!-- ===== RetroWindow ================================================== -->
  <Style x:Key="Retro.CaptionButton" TargetType="Button">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ctl:Bevel x:Name="Bevel" Kind="Raised" Background="{DynamicResource Retro.Surface}">
            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bevel" Property="Kind" Value="Sunken"/>
              <Setter TargetName="Glyph" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform X="1" Y="1"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Glyph" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ctl:RetroWindow">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
    <Setter Property="shell:WindowChrome.WindowChrome">
      <Setter.Value>
        <shell:WindowChrome CaptionHeight="22" ResizeBorderThickness="4" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:RetroWindow">
          <ctl:Bevel x:Name="Frame" Kind="RaisedStrong" Background="{TemplateBinding Background}">
            <DockPanel>
              <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="{DynamicResource Retro.Gradient.TitleBar}"
                      BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Retro.TitleBarBorder}" Padding="6,3">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding TitleBarContent}" Margin="0,0,6,0" VerticalAlignment="Center"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                      TextElement.Foreground="{DynamicResource Retro.ForegroundOnHeader}"/>
                    <Button x:Name="MinimizeButton" Style="{StaticResource Retro.CaptionButton}" ToolTip="Minimize"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                      <Path Data="{StaticResource Retro.Glyph.Minimize}" Fill="{DynamicResource Retro.Foreground}" Stretch="None" Width="8" Height="7"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource Retro.CaptionButton}" ToolTip="Maximize" Margin="6,0,0,0"
                            Command="{x:Static SystemCommands.MaximizeWindowCommand}">
                      <Path Data="{StaticResource Retro.Glyph.Maximize}" Fill="{DynamicResource Retro.Foreground}" Stretch="None"/>
                    </Button>
                    <Button x:Name="RestoreButton" Style="{StaticResource Retro.CaptionButton}" ToolTip="Restore" Margin="6,0,0,0"
                            Command="{x:Static SystemCommands.RestoreWindowCommand}" Visibility="Collapsed">
                      <Path Data="{StaticResource Retro.Glyph.Restore}" Fill="{DynamicResource Retro.Foreground}" Stretch="None"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource Retro.CaptionButton}" ToolTip="Close" Margin="6,0,0,0"
                            Command="{x:Static SystemCommands.CloseWindowCommand}">
                      <Path Data="{StaticResource Retro.Glyph.Close}" Fill="{DynamicResource Retro.Foreground}" Stretch="None"/>
                    </Button>
                  </StackPanel>
                  <ctl:RetroIcon x:Name="TitleIcon" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Kind="{Binding TitleIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Retro.NullSkip}}"/>
                  <Grid VerticalAlignment="Center" TextElement.FontFamily="{DynamicResource Retro.FontFamily.Bold}"
                        TextElement.FontWeight="Bold" TextElement.FontSize="{DynamicResource Retro.FontSize.MD}">
                    <!-- text-shadow: 0 1px 0 rgba(0,0,0,.4) -->
                    <TextBlock Text="{TemplateBinding Title}" Foreground="{DynamicResource Retro.TextShadow}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{TemplateBinding Title}" Foreground="{DynamicResource Retro.ForegroundOnHeader}" Margin="0,0,0,1" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DockPanel>
              </Border>
              <AdornerDecorator>
                <ContentPresenter/>
              </AdornerDecorator>
            </DockPanel>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="TitleIcon" Value="{x:Null}">
              <Setter TargetName="TitleIcon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter TargetName="Frame" Property="Margin" Value="{x:Static ctl:RetroWindow.MaximizedMargin}"/>
              <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ResizeMode" Value="CanMinimize">
              <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="ResizeMode" Value="NoResize">
              <Setter TargetName="MinimizeButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="CloseButton" Property="Margin" Value="0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ctl:RetroDialog" BasedOn="{StaticResource {x:Type ctl:RetroWindow}}">
    <Setter Property="Background" Value="{DynamicResource Retro.Surface}"/>
  </Style>

  <!-- ===== ToggleSwitch ================================================= -->
  <Style TargetType="ctl:ToggleSwitch">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Retro.FocusVisual.Tight}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:ToggleSwitch">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <ctl:Bevel x:Name="Track" Kind="Sunken" Width="36" Height="18" Background="{TemplateBinding Background}">
              <ctl:Bevel x:Name="Knob" Kind="Raised" Width="16" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Background="{DynamicResource Retro.Gradient.Button}"/>
            </ctl:Bevel>
            <ContentPresenter x:Name="Content" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Retro.Accent}"/>
              <Setter TargetName="Knob" Property="Margin" Value="17,0,0,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Retro.Surface2}"/>
              <Setter TargetName="Track" Property="Opacity" Value="0.6"/>
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Tag ========================================================== -->
  <Style TargetType="ctl:Tag">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.XS}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.StatusInfo}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.StatusInfoBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Retro.StatusInfo}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="5,0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Tag">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter VerticalAlignment="Center"/>
              <Button x:Name="PART_Close" Style="{StaticResource Retro.CloseX}" Margin="3,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsClosable" Value="True">
              <Setter TargetName="PART_Close" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="Warning">
        <Setter Property="Foreground" Value="{DynamicResource Retro.StatusWarningText}"/>
        <Setter Property="Background" Value="{DynamicResource Retro.StatusWarningBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Retro.StatusWarning}"/>
      </Trigger>
      <Trigger Property="Tone" Value="Error">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{DynamicResource Retro.StatusError}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Retro.StatusErrorBorder}"/>
      </Trigger>
      <Trigger Property="Tone" Value="Success">
        <Setter Property="Foreground" Value="{DynamicResource Retro.StatusSuccess}"/>
        <Setter Property="Background" Value="{DynamicResource Retro.StatusSuccessBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Retro.StatusSuccess}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== MessageStrip ================================================= -->
  <Style TargetType="ctl:MessageStrip">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Retro.BorderMid}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="5,2"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:MessageStrip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <DockPanel>
              <Button x:Name="PART_Close" DockPanel.Dock="Right" Style="{StaticResource Retro.CloseX}" Margin="6,0,0,0"/>
              <ctl:RetroIcon x:Name="Icon" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                             Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Retro.NullSkip}}"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsClosable" Value="False">
              <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Severity" Value="Info">
        <Setter Property="Background" Value="{DynamicResource Retro.StatusInfoBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Retro.StatusInfo}"/>
      </Trigger>
      <Trigger Property="Severity" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource Retro.StatusWarningBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Retro.StatusWarning}"/>
      </Trigger>
      <Trigger Property="Severity" Value="Error">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{DynamicResource Retro.StatusError}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Retro.StatusErrorBorder}"/>
      </Trigger>
      <Trigger Property="Severity" Value="Success">
        <Setter Property="Background" Value="{DynamicResource Retro.StatusSuccessBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Retro.StatusSuccess}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Badge ======================================================== -->
  <Style TargetType="ctl:Badge">
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Badge">
          <Grid>
            <ContentPresenter/>
            <Border x:Name="Bubble" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                    Background="#FFFFFF" CornerRadius="8" Padding="1" Visibility="Collapsed" IsHitTestVisible="False">
              <Border Background="{DynamicResource Retro.StatusError}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0">
                <TextBlock Text="{TemplateBinding DisplayText}" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold"
                           FontFamily="{DynamicResource Retro.FontFamily.Bold}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsBadgeVisible" Value="True">
              <Setter TargetName="Bubble" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Avatar ======================================================= -->
  <Style TargetType="ctl:Avatar">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily.Bold}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Surface2}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Avatar">
          <!-- 1px dark outer ring, 2px white inner ring, then the fill. -->
          <Grid>
            <Ellipse Fill="{DynamicResource Retro.BorderDark}"/>
            <Grid Margin="1" Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
              <Ellipse Fill="{DynamicResource Retro.BorderLight}"/>
              <Ellipse Margin="2" Fill="{TemplateBinding Background}"/>
              <TextBlock Text="{TemplateBinding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse x:Name="Photo" Margin="2">
                <Ellipse.Fill>
                  <ImageBrush ImageSource="{Binding ImageSource, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill"/>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ImageSource" Value="{x:Null}">
              <Setter TargetName="Photo" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Breadcrumb =================================================== -->
  <Style TargetType="ctl:BreadcrumbItem">
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Retro.FocusVisual.Tight}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:BreadcrumbItem">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="Separator" Text="›" Margin="4,0" Foreground="{DynamicResource Retro.ForegroundMuted}" VerticalAlignment="Center"/>
            <ContentPresenter x:Name="Link" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Retro.Link}">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextDecorations" Value="Underline"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <ContentPresenter x:Name="Current" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFirst" Value="True">
              <Setter TargetName="Separator" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Link" Property="TextElement.Foreground" Value="{DynamicResource Retro.LinkHover}"/>
            </Trigger>
            <Trigger Property="IsCurrent" Value="True">
              <Setter TargetName="Link" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Current" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsCurrent" Value="False">
        <Setter Property="Cursor" Value="Hand"/>
      </Trigger>
      <Trigger Property="IsCurrent" Value="True">
        <Setter Property="Focusable" Value="False"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ctl:Breadcrumb">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Breadcrumb">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Pagination =================================================== -->
  <Style x:Key="Retro.PageButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.Gradient.Button}"/>
    <Setter Property="MinWidth" Value="22"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="5,0"/>
    <Setter Property="Margin" Value="0,0,1,0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Retro.FocusVisual.Tight}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ctl:Bevel x:Name="Bevel" Kind="Raised" Background="{TemplateBinding Background}">
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bevel" Property="Kind" Value="Sunken"/>
              <Setter TargetName="Bevel" Property="Background" Value="{DynamicResource Retro.Gradient.ButtonPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ctl:Pagination">
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Pagination">
          <ItemsControl ItemsSource="{TemplateBinding Pages}" Focusable="False" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type ctl:PageEntry}">
                <Button x:Name="PageButton" Style="{StaticResource Retro.PageButton}" Content="{Binding Label}"
                        Command="{x:Static ctl:Pagination.GoToPageCommand}" CommandParameter="{Binding Page}"
                        IsEnabled="{Binding IsEnabled}"/>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="PageButton" Property="Background" Value="{DynamicResource Retro.Accent}"/>
                    <Setter TargetName="PageButton" Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Ellipsis">
                    <Setter TargetName="PageButton" Property="Command" Value="{x:Null}"/>
                    <Setter TargetName="PageButton" Property="IsEnabled" Value="True"/>
                    <Setter TargetName="PageButton" Property="IsHitTestVisible" Value="False"/>
                    <Setter TargetName="PageButton" Property="Focusable" Value="False"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== FormField ==================================================== -->
  <Style TargetType="ctl:FormField">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:FormField">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="{TemplateBinding LabelWidth}" Margin="0,0,8,0" Padding="0,3,0,0" VerticalAlignment="Top">
              <StackPanel x:Name="LabelRow" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{TemplateBinding Label}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Star" Text=" *" Foreground="{DynamicResource Retro.StatusError}" Visibility="Collapsed"/>
                <TextBlock x:Name="Colon" Text=":"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              <TextBlock x:Name="Help" Text="{TemplateBinding HelpText}" Margin="0,1,0,0" TextWrapping="Wrap"
                         FontSize="{DynamicResource Retro.FontSize.XS}" Foreground="{DynamicResource Retro.ForegroundMuted}"
                         Visibility="{Binding HelpText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Retro.NotEmptyToVisibility}}"/>
              <TextBlock x:Name="Error" Text="{TemplateBinding ErrorText}" Margin="0,1,0,0" TextWrapping="Wrap"
                         FontSize="{DynamicResource Retro.FontSize.XS}" Foreground="{DynamicResource Retro.StatusError}" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsRequired" Value="True">
              <Setter TargetName="Star" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ShowColon" Value="False">
              <Setter TargetName="Colon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="LabelRow" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="HasError" Value="True">
              <Setter TargetName="LabelRow" Property="TextElement.Foreground" Value="{DynamicResource Retro.StatusError}"/>
              <Setter TargetName="Help" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Error" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Timeline ===================================================== -->
  <Style TargetType="ctl:TimelineItem">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.Foreground}"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:TimelineItem">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="11" Height="11" Margin="1,3,0,0" Padding="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource Retro.BorderBlack}" SnapsToDevicePixels="True">
              <Rectangle x:Name="Marker" Fill="{DynamicResource Retro.HeaderBlue2}"/>
            </Border>
            <StackPanel Grid.Column="1">
              <ContentPresenter ContentSource="Header" TextElement.FontWeight="Bold"
                                TextElement.FontFamily="{DynamicResource Retro.FontFamily.Bold}"/>
              <ContentPresenter TextElement.FontSize="{DynamicResource Retro.FontSize.XS}"
                                TextElement.Foreground="{DynamicResource Retro.ForegroundMuted}"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Marker" Property="Fill" Value="{DynamicResource Retro.Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ctl:Timeline">
    <Setter Property="Padding" Value="0,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Timeline">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== EmptyState =================================================== -->
  <Style TargetType="ctl:EmptyState">
    <Setter Property="FontFamily" Value="{DynamicResource Retro.FontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource Retro.FontSize.SM}"/>
    <Setter Property="Foreground" Value="{DynamicResource Retro.ForegroundMuted}"/>
    <Setter Property="Background" Value="{DynamicResource Retro.SurfaceInset}"/>
    <Setter Property="MinHeight" Value="200"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:EmptyState">
          <ctl:Bevel Kind="SunkenStrong" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <ctl:Bevel Kind="Sunken" Width="48" Height="48" Background="{DynamicResource Retro.Surface2}" HorizontalAlignment="Center">
                <ctl:RetroIcon Kind="{TemplateBinding Icon}" Size="32"/>
              </ctl:Bevel>
              <TextBlock Text="{TemplateBinding Title}" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                         FontFamily="{DynamicResource Retro.FontFamily.Bold}" FontWeight="Bold"/>
              <TextBlock x:Name="Description" Text="{TemplateBinding Description}" Margin="0,6,0,0" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" FontSize="{DynamicResource Retro.FontSize.XS}"/>
              <ContentPresenter x:Name="Action" Content="{TemplateBinding Action}" Margin="0,12,0,0" HorizontalAlignment="Center"
                                TextElement.Foreground="{DynamicResource Retro.Foreground}"/>
            </StackPanel>
          </ctl:Bevel>
          <ControlTemplate.Triggers>
            <Trigger Property="Description" Value="{x:Null}">
              <Setter TargetName="Description" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Action" Value="{x:Null}">
              <Setter TargetName="Action" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
